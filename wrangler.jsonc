{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-11",
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],
  "assets": {
    "directory": "./assets/default",
    "binding": "PASS_ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "291104731",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
