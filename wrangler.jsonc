{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-11",
  // Old Worker versions can remain reachable through versioned preview URLs
  // after their version and deployment records are deleted.
  "preview_urls": false,
  "assets": {
    "directory": "./.assets.deploy",
    "binding": "PASS_ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "291104731",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "name": "zal-pass"
}
