{
  "name": "loungekey-pkpass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.node.json",
    "build:cloudflare": "npm run prepare:worker-assets",
    "check": "biome check . && tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "deploy": "wrangler deploy --strict",
    "dev": "wrangler dev",
    "prepare:worker-assets": "node scripts/prepare-worker-assets.mjs",
    "start": "node dist/node.js",
    "test": "vitest run",
    "test:worker": "npm run prepare:worker-assets && vitest run --config vitest.worker.config.ts"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261119.1",
    "@types/node": "24.13.3",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.165.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "$sharp",
    "undici": "7.30.2",
    "zod": "4.6.7"
  }
}
